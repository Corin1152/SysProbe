<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- 只写构建设置表达不了的键。`GENERATE_INFOPLIST_FILE` 会把这份并进
	     合成出来的整份 plist（扩展的 NSExtension 同理）。

	     启动屏底色取画布的深色端，跟 `Backdrop` 的渐变对得上。
	     `UIColorName` 就是 `UILaunchScreen` 的全部内容 —— 别再打开
	     `INFOPLIST_KEY_UILaunchScreen_Generation`，那个设置会额外塞一个未文档化的
	     嵌套键进来。 -->
	<key>UILaunchScreen</key>
	<dict>
		<key>UIColorName</key>
		<string>LaunchBackground</string>
	</dict>

	<!-- 负一屏组件点一下就打开主 App。
	     扩展那边走 `extensionContext.open(URL(string: "sysprobe://open")!)`
	     （见 `TodayViewController.openApp`）—— 扩展里没有 `UIApplication`，
	     这是唯一能唤起居主 App 的通道，所以主 App 必须先把这个 scheme 注册上，
	     否则 `open` 会静默失败。
	     与 CPU-X 同一条路：它注册的是 `armcpuz`。
	     写成局部 plist 而不是 `INFOPLIST_KEY_*`：这是个数组，构建设置表达不了。 -->
	<key>CFBundleURLTypes</key>
	<array>
		<dict>
			<key>CFBundleTypeRole</key>
			<string>Editor</string>
			<key>CFBundleURLName</key>
			<string>com.corin.sysprobe</string>
			<key>CFBundleURLSchemes</key>
			<array>
				<string>sysprobe</string>
			</array>
		</dict>
	</array>
</dict>
</plist>
